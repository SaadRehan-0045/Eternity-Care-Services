                                    <i class="ri-facebook-fill text-2xl mr-3 text-yellow-300 group-hover:scale-110 transition-transform"></i>
                                    <span class="font-medium">Facebook</span>
                                </a>
                                <a href="#" class="flex items-center text-white/80 hover:text-white hover:pl-2 transition-all duration-200 group">
                                    <i class="ri-twitter-fill text-2xl mr-3 text-yellow-300 group-hover:scale-110 transition-transform"></i>
                                    <span class="font-medium">Twitter</span>
                                </a>
                                <a href="#" class="flex items-center text-white/80 hover:text-white hover:pl-2 transition-all duration-200 group">
                                    <i class="ri-linkedin-fill text-2xl mr-3 text-yellow-300 group-hover:scale-110 transition-transform"></i>
                                    <span class="font-medium">LinkedIn</span>
                                </a>
                                <a href="#" class="flex items-center text-white/80 hover:text-white hover:pl-2 transition-all duration-200 group">
                                    <i class="ri-instagram-line text-2xl mr-3 text-yellow-300 group-hover:scale-110 transition-transform"></i>
