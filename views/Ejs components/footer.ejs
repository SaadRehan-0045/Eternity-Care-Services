                                        <p><span class="font-medium text-yellow-300">Saturday – Sunday:</span> 07:00 AM - 12:00 PM</p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Copyright -->
                        <div class="mt-8 pt-6 border-t border-white/20">
                            <p class="text-center text-white/80 text-sm flex items-center justify-center">
                                Copyright © 2026. All rights reserved - 
                                <i class="ri-heart-pulse-fill mx-1 text-yellow-300"></i> 
                               Eternity Care Services
