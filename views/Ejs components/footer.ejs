                            </div>
                        </div>

                        <!-- Opening Hours -->
                        <div class="space-y-3 border-t border-white/20 pt-6">
                            <div class="flex items-start">
                                <i class="ri-time-line text-yellow-300 mr-3 mt-1 text-xl"></i>
                                <div>
                                    <h3 class="font-medium text-white mb-2">Opening Hours</h3>
                                    <div class="text-white/80 text-sm space-y-1">
