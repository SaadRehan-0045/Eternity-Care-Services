    </section>

    <!-- Call to Action - Join Our Mission -->
    <section class="container mx-auto px-4 py-16 md:py-20 text-center">
        <div class="max-w-3xl mx-auto">
            <div class="w-20 h-20 bg-blue-100 dark:bg-blue-900/40 rounded-full flex items-center justify-center mx-auto mb-6">
